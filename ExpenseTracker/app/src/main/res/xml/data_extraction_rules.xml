<?xml version="1.0" encoding="utf-8"?>
<!-- The database holds financial transaction history. Cloud backup is therefore disabled for
     the database, while device-to-device transfer keeps the database available when physically
     moving the app to a new device. Preferences DataStore stores only non-financial settings and
     app state, so it is explicitly included in both backup modes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
