<?xml version="1.0" encoding="utf-8"?>
<!-- The database contains financial transaction history, so it is intentionally NOT included
     in cloud backup. Because explicit <include> rules are present below, Android backs up only
     the listed domains; database is therefore excluded implicitly. Device-to-device transfer
     explicitly includes the database so local data moves with the app. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
